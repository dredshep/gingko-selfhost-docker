# Public app port on the mini PC.
GINGKO_PORT=3000

# Used at build time for a few baked client links. Same-origin API/websocket works even behind a reverse proxy.
PUBLIC_URL=http://localhost:3000

# Optional: pin branches/tags/commits. master follows upstream.
GINGKO_CLIENT_REF=master
GINGKO_SERVER_REF=master

# Change these before exposing the app outside your LAN.
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-this-couchdb-password
COUCHDB_SECRET=change-this-couchdb-secret
SESSION_SECRET=change-this-session-secret

# Optional integrations. Leave empty/disabled for a private self-host.
ANTHROPIC_API_KEY=
MAILGUN_API_KEY=disabled
MAILGUN_DOMAIN=disabled.local
MAILERLITE_API_KEY=disabled
SUPPORT_EMAIL=support@localhost
SUPPORT_URGENT_EMAIL=urgent@localhost
NTFY_URL=https://ntfy.sh/gingko-selfhost-disabled
STRIPE_SECRET_KEY=sk_test_selfhost000000000000000000000000
